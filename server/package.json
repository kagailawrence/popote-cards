{
  "name": "popote-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrateAll.ts",
    "db:seed": "tsx src/db/seed47Counties.ts",
    "db:migrate:prod": "node dist/db/migrateAll.js",
    "db:seed:prod": "node dist/db/seed47Counties.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "file-type": "^22.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.20.5",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "sharp"
    ]
  }
}